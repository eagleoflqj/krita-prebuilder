 // The wasm instance will then call the C++ event after it is resumed.
 void qtRegisterEventHandlerJs(int index) {
     EM_ASM({
+        // Browsers clear transient event state when dispatch returns. Keep
+        // the values needed by handlers that run after a JSPI suspension.
+        function snapshotEvent(event) {
+            if (!(event instanceof Event))
+                return event;
+            const path = event.composedPath();
+            const copy = {};
+            for (const key in event) {
+                // Qt uses PointerEvent.pressure and PointerEvent.pointerType.
+                if (key === 'mozPressure' || key === 'mozInputSource')
+                    continue;
+                const value = event[key];
+                copy[key] = typeof value === 'function' ? value.bind(event) : value;
+            }
+            copy.composedPath = () => path;
+            return copy;
+        }
+
         let index = $0;
         let control = Module.qtSuspendResumeControl;
         let handler = (arg) => {
+            arg = snapshotEvent(arg);
 
