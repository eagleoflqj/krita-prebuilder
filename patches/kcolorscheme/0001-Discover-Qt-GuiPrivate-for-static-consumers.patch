Subject: [PATCH] Discover Qt GuiPrivate for static consumers

Qt 6.10 split private targets into separate packages.

--- a/KF6ColorSchemeConfig.cmake.in
+++ b/KF6ColorSchemeConfig.cmake.in
@@ -8,6 +8,11 @@
 
 if (NOT @BUILD_SHARED_LIBS@)
     find_dependency(Qt6Gui @REQUIRED_QT_VERSION@)
+    if(Qt6Gui_VERSION VERSION_GREATER_EQUAL "6.10.0")
+        find_dependency(Qt6GuiPrivate @REQUIRED_QT_VERSION@)
+    else()
+        find_dependency(Qt6Gui @REQUIRED_QT_VERSION@ COMPONENTS Private)
+    endif()
     find_dependency(KF6GuiAddons "@KF_DEP_VERSION@")
     find_dependency(KF6I18n "@KF_DEP_VERSION@")
 endif()
